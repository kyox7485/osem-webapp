# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The app's own public origin, no trailing slash. Server actions use this to
# build the Supabase Auth email links (invite / password reset) instead of
# deriving an origin from the incoming request, so a link minted from a Vercel
# preview deployment still points at production. MUST also be listed in
# Supabase -> Authentication -> URL Configuration -> Redirect URLs, or
# Supabase discards it and sends the invitee to Supabase's own applet.
NEXT_PUBLIC_APP_URL=https://YOUR-VERCEL-HOSTNAME

# Only needed server-side for admin actions (e.g. inviting staff users).
# Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Local OmniRoute AI gateway (server-side only, never expose to the browser)
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=YOUR-OMNIROUTE-API-KEY

# Wound Photo module: Drive access goes through an Apps Script Web App
# deployed under OSEM's personal Google account (osemmedicare@gmail.com),
# not a Google Cloud service account -- a personal account has no Shared
# Drive to point a service account at. See
# google-apps-script/wound-photo-drive.gs for the script and its
# deployment steps. Server-side only, never expose to the browser.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
GOOGLE_APPS_SCRIPT_SECRET=YOUR-SHARED-SECRET
