# Path to the Access backend file with the live operational data
ACCESS_DB_PATH=Z:\My Drive\OSEM MS\OSEM WebApp\OSEM MS_be.accdb

# Branch code this run is loading (must match tbl_branches.code, e.g. ALMA)
BRANCH_CODE=ALMA

# Direct Postgres connection string for Supabase (Session Pooler or direct
# connection - NOT the REST API). Find it in Supabase dashboard:
# Project Settings -> Database -> Connection string -> URI
# Use the "postgres" user (or a role with enough privilege to disable
# triggers temporarily), not the anon/service-role API keys.
PG_DSN=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
