      executionId
    );

  Logger.log(
    JSON.stringify(
      {
        residentID:
          report.residentID,
        resident:
          report.resident.Residents,
        pages:
          report.sheets.length,
        executionId:
          executionId
      },
      null,
      2
    )
  );
}
